      "id": "audit",
      "name": "Exact Market Audit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2380,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const selected=$('Select Active Listings').all();\nconst responses=$input.all();\nconst oldValues=($('Read Existing Sale Agent').first().json.values||[]);\nconst oldHeaders=(oldValues[0]||[]).map(v=>String(v??'').trim());\nfunction oldObj(row){const o={};oldHeaders.forEach((h,i)=>o[h]=row[i]??'');return o;}\nfunction t(v){return v===null||v===undefined?'':String(v).trim();}\nfunction num(v){const x=Number(v);return Number.isFinite(x)?x:null;}\nfunction money(v){return Math.round((Number(v||0)+Number.EPSILON)*100)/100;}\nfunction parseItemId(titleCell){\n  const m=String(titleCell||'').match(/\\/itm\\/(\\d+)/);\n  return m?m[1]:'';\n}\nconst oldMap={};\nfor(let i=1;i<oldValues.length;i++){\n  const r=oldObj(oldValues[i]);\n  const itemId=parseItemId(r.Title);\n  const suggestion=t(r['Suggested Sale']);\n  if(itemId && suggestion){\n    oldMap[itemId+'|'+suggestion]=t(r.Decision).toUpperCase();\n  }\n}\nconst cost=Number($('Config').first().json.productCost||3);\nconst rows=[];\nconst generatedAt=new Date().toISOString();\nlet audited=0,insufficient=0,notAboveMarket=0;\nfor(let i=0;i<selected.length;i++){\n  const src=selected[i].json;\n  const body=(responses[i]&&responses[i].json)||{};\n  if(!body.ok || !body.audit){insufficient++;continue;}\n  audited++;\n  const audit=body.audit;\n  const data=audit.data||audit.DATA||{};\n  const market=audit.market||audit.MARKET||{};\n  const exact=Number(market.exactCompetitorCount||0);\n  const median=num(market.medianComparableBuyerTotal);\n  const ownTotal=num(market.ourBuyerTotal);\n  let shipping=num(data.shipping);\n  if(shipping===null && ownTotal!==null) shipping=money(Math.max(0,ownTotal-src.currentPrice));\n  if(exact<2 || median===null){insufficient++;continue;}\n  const targetItem=money(Math.max(0.99,median-(shipping||0)));\n  if(src.currentPrice<=targetItem*1.03){notAboveMarket++;continue;}\n  const needed=((src.currentPrice-targetItem)/src.currentPrice)*100;\n  let discount=Math.round(needed/5)*5;\n  discount=Math.max(5,Math.min(15,discount));\n  const salePrice=money(src.currentPrice*(1-discount/100));\n  const afterCost=money(salePrice-cost);\n  if(afterCost<1) continue;\n  const suggestion=discount+'% → $'+salePrice.toFixed(2);\n  const key=src.itemId+'|'+suggestion;\n  const oldDecision=oldMap[key]||'';\n  const decision=['APPROVE','SKIP','DONE','FAILED'].includes(oldDecision)?oldDecision:'';\n  const safeTitle=(src.title||src.sku||src.itemId).replace(/\"/g,'\"\"');\n  const safeUrl=String(src.ebayUrl||('https://www.ebay.com/itm/'+src.itemId)).replace(/\"/g,'');\n  const titleFormula='=HYPERLINK(\"'+safeUrl+'\",\"'+safeTitle+'\")';\n  rows.push([\n    src.sku,\n    titleFormula,\n    src.currentPrice,\n    median,\n    suggestion,\n    afterCost,\n    decision\n  ]);\n}\nreturn [{json:{rows,rowCount:rows.length,audited,insufficient,notAboveMarket,generatedAt}}];"
      },
