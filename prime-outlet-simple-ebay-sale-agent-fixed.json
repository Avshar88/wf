    {
      "parameters": {
        "jsCode": "const rows=$('Build Simple Sale Rows').first().json.rows||[];\nconst generatedAt=$('Build Simple Sale Rows').first().json.generatedAt;\nfunction parseItemId(titleCell){\n  const m=String(titleCell||'').match(/\\/itm\\/(\\d+)/);\n  return m?m[1]:'';\n}\nfunction salePrice(text){\n  const m=String(text||'').match(/\\$([0-9]+(?:\\.[0-9]+)?)/);\n  return m?Number(m[1]):null;\n}\nconst out=[];\nfor(let i=0;i<rows.length;i++){\n  const r=rows[i];\n  if(String(r[6]||'').trim().toUpperCase()!=='APPROVE') continue;\n  const itemId=parseItemId(r[1]);\n  const proposed=salePrice(r[4]);\n  if(!itemId || proposed===null) continue;\n  out.push({json:{\n    kind:'approval',\n    rowNumber:i+2,\n    itemId,\n    sku:String(r[0]||''),\n    currentPrice:Number(r[2]),\n    proposedPrice:proposed,\n    analyzedAt:generatedAt\n  }});\n}\nreturn out.length?out:[{json:{kind:'none'}}];"
      },
