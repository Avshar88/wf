    {
      "parameters": {
        "jsCode": "const selected=$('Select APPROVE Rows').all().filter(x=>x.json.kind==='approval');\nconst responses=$input.all();\nconst data=[];\nlet done=0,failed=0;\nfor(let i=0;i<selected.length;i++){\n  const src=selected[i].json;\n  const body=(responses[i]&&responses[i].json)||{};\n  const ok=body.ok===true;\n  if(ok) done++; else failed++;\n  data.push({\n    range:\"'\"+$('Config').first().json.saleSheetName+\"'!G\"+src.rowNumber,\n    majorDimension:'ROWS',\n    values:[[ok?'DONE':'FAILED']]\n  });\n}\nreturn [{json:{data,done,failed,attempted:selected.length}}];"
      },
