    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_EBAY_AUDIT_WEB_APP_URL }}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action:'ebay_listing_audit', itemId:$json.itemId, sku:$json.sku||'', sharedSecret:$env.N8N_EBAY_AUDIT_SHARED_SECRET }) }}",
