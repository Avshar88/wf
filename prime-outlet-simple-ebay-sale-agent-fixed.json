    {
      "parameters": {
        "jsCode": "const values=$input.first().json.values||[];\nif(values.length<2) return [];\nconst headers=values[0].map(v=>String(v??'').trim());\nconst max=Math.max(1,Math.min(50,Number($('Config').first().json.maxAuditItems||20)));\nfunction obj(row){const o={};headers.forEach((h,i)=>o[h]=row[i]??'');return o;}\nfunction t(v){return v===null||v===undefined?'':String(v).trim();}\nfunction n(v){const x=Number(v);return Number.isFinite(x)?x:null;}\nconst out=[];\nfor(let i=1;i<values.length;i++){\n  const r=obj(values[i]);\n  const itemId=t(r['Item ID']);\n  const qty=n(r['Available Qty']);\n  const price=n(r.Price);\n  if(!itemId || qty===null || qty<=0 || price===null || price<=0) continue;\n  out.push({json:{\n    itemId,\n    sku:t(r.SKU),\n    title:t(r.Title),\n    ebayUrl:t(r['eBay URL'])||('https://www.ebay.com/itm/'+itemId),\n    currentPrice:price\n  }});\n  if(out.length>=max) break;\n}\nreturn out;"
      },
