        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action:'ebay_marketing_markdown_sale', approved:true, runRequested:true, itemId:$json.itemId, sku:$json.sku||'', proposedPrice:$json.proposedPrice, expectedCurrentPrice:$json.currentPrice, priceFloor:$json.priceFloor, analyzedAt:$json.analyzedAt, durationDays:$('Config').first().json.saleDurationDays }) }}",
        "options": {}
      },
      "id": "execute",
      "name": "Execute APPROVED Sale Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        220
      ],
      "credentials": {
        "httpQueryAuth": {
          "id": "poWriteQuery2026",
          "name": "Prime Outlet eBay Write Query Auth"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const cfg=$('Config').first().json;\nconst selected=$('Select Approved').all().map(x=>x.json);\nconst approvals=selected.filter(x=>x.kind==='approval');\nlet responses=[];\ntry{ responses=$('Execute APPROVED Sale Event').all(); }catch(e){}\nconst today=new Date().toISOString().slice(0,10);\nconst sheet=\"'\"+cfg.saleSheetName+\"'\";\nfunction errText(b){\n  const e=b.error||b.message||b.reason||'';\n  const s=typeof e==='string'?e:(e.message||JSON.stringify(e));\n  return (s||'անհայտ սխալ').slice(0,150);\n}\nconst data=[];\nconst results=[];\nlet done=0,failed=0;\napprovals.forEach((a,i)=>{\n  const b=(responses[i]&&responses[i].json)||{};\n  const ok=b.ok===true;\n  if(ok) done++; else failed++;\n  const status=ok?'✅ Ստեղծված '+today:'❌ Սխալ — '+errText(b);\n  data.push({range:sheet+'!H'+a.rowNumber,majorDimension:'ROWS',values:[[status]]});\n  results.push({row:a.rowNumber,itemId:a.itemId,ok});\n});\nfor(const inv of (selected[0]&&selected[0].invalid)||[]){\n  failed++;\n  data.push({range:sheet+'!H'+inv.rowNumber,majorDimension:'ROWS',values:[['❌ '+inv.reason]]});\n}\nreturn [{json:{data,hasUpdates:data.length>0,attempted:approvals.length,done,failed,results}}];"
      },
