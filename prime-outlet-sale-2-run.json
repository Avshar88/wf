    {
      "parameters": {
        "jsCode": "// Webhook calls must carry the shared secret; manual runs skip this check\nconst cfg=$input.first().json;\nlet body;\ntry{ body=$('Run Webhook').first().json.body; }catch(e){ body=undefined; }\nif(body!==undefined && String((body||{}).secret||'')!==String(cfg.webhookSecret||'')){\n  throw new Error('Wrong or missing secret');\n}\nreturn [{json:cfg}];"
      },
      "id": "18102dff-b75d-54c6-84f0-2794f1cda8b4",
      "name": "Check Secret",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ 'https://sheets.googleapis.com/v4/spreadsheets/' + $('Config').first().json.controlSpreadsheetId + '/values/%27' + encodeURIComponent($('Config').first().json.saleSheetName) + '%27!A1:L1000?valueRenderOption=UNFORMATTED_VALUE' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {}
      },
      "id": "0471e9e5-ab4e-529e-889e-71fd16bb52c7",
      "name": "Read Sale Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const COL={title:0,price:1,median:2,offer:3,net:4,margin:5,decision:6,status:7,itemId:8,sku:9,floor:10,sale:11};\nfunction t(v){return v===null||v===undefined?'':String(v).trim();}\nfunction num(v){if(v===null||v===undefined||v==='')return null;const x=Number(v);return Number.isFinite(x)?x:null;}\nfunction normDecision(v){const s=t(v).toUpperCase();if(['ԱՅՈ','YES','Y','APPROVE'].includes(s))return 'YES';if(['ՈՉ','NO','N','SKIP'].includes(s))return 'NO';return '';}\nfunction isDone(s){return t(s).startsWith('✅');}\nconst values=$input.first().json.values||[];\nif(t((values[0]||[])[COL.itemId])!=='Item ID') throw new Error('Sale Agent tab is not in the expected layout. Run \"Refresh\" first.');\nconst valid=[],invalid=[];\nfor(let i=1;i<values.length;i++){\n  const r=values[i]||[];\n  if(normDecision(r[COL.decision])!=='YES' || isDone(r[COL.status])) continue;\n  const rowNumber=i+1;\n  const itemId=t(r[COL.itemId]);\n  const sale=num(r[COL.sale]);\n  const floor=num(r[COL.floor]);\n  const price=num(r[COL.price]);\n  if(!itemId || sale===null || price===null){invalid.push({rowNumber,reason:'Տողում տվյալ չկա, թարմացրու առաջարկները'});continue;}\n  if(floor===null || sale<floor){invalid.push({rowNumber,reason:'Գինը ցածր է Min Price-ից'});continue;}\n  valid.push({kind:'approval',rowNumber,itemId,sku:t(r[COL.sku]),currentPrice:price,proposedPrice:sale,priceFloor:floor});\n}\nconst analyzedAt=new Date().toISOString();\nif(!valid.length) return [{json:{kind:'none',invalid}}];\nreturn valid.map(v=>({json:{...v,analyzedAt,invalid}}));"
      },
      "id": "81f2e833-33a6-5fad-8ee1-d7a7c813b22f",
      "name": "Select Approved",
